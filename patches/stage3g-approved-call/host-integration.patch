diff --git a/exec/src/approved_delegate_host.rs b/exec/src/approved_delegate_host.rs
new file mode 100644
index 0000000000000000000000000000000000000000..eb9198cfd9274275fc7f52de053b07541892aafb
--- /dev/null
+++ b/exec/src/approved_delegate_host.rs
@@ -0,0 +1,254 @@
+//! Trusted `codex exec` Stage 3G tool ceilings.
+//!
+//! Authority comes only from the dedicated host startup manifest and arm option.
+//! Task input, MCP metadata, model output, and project files never populate it.
+
+use crate::cli::Stage3gHostArm;
+use anyhow::Context;
+use codex_core::ApprovedDelegatePolicy;
+use codex_core::ProofRouterObserver;
+use codex_core::config::Config;
+use codex_extension_api::AllowedTools;
+use codex_extension_api::ExtensionDataInit;
+use codex_tools::ToolName;
+use serde::Deserialize;
+use serde_json::Value;
+use sha2::Digest;
+use sha2::Sha256;
+use std::collections::BTreeMap;
+use std::path::Path;
+
+const MANIFEST_VERSION: u32 = 2;
+const SERVER_KEY: &str = "devhub_delegate";
+const RAW_TOOL: &str = "devhub_delegate";
+const CANONICAL_NAMESPACE: &str = "mcp__devhub_delegate";
+const CANONICAL_FUNCTION: &str = "devhub_delegate";
+const ALLOWED_TOOL: &str = "mcp__devhub_delegate.devhub_delegate";
+const SCHEMA_SHA256: &str = "0f06b9fc3d912389721413789835053eefb2db7cc14781829bd57234c7e371be";
+const GLOBAL_MODE: &str = "CodeModeOnly";
+
+#[derive(Debug, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Stage3gHostManifest {
+    schema_version: u32,
+    expected_global_tool_mode: String,
+    error_on_tool_collisions: bool,
+    arms: Stage3gArms,
+}
+
+#[derive(Debug, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Stage3gArms {
+    arm_a: Stage3gArmPolicy,
+    arm_b: Stage3gArmPolicy,
+}
+
+#[derive(Debug, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Stage3gArmPolicy {
+    tool_ceiling: Vec<String>,
+    approved_delegate: Option<ApprovedDelegateManifest>,
+}
+
+#[derive(Debug, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct ApprovedDelegateManifest {
+    server_key: String,
+    raw_tool: String,
+    canonical_namespace: String,
+    canonical_function: String,
+    expected_mcp_server_config_sha256: String,
+    expected_input_schema: Value,
+    expected_input_schema_sha256: String,
+    direct_only_tool_namespaces: Vec<String>,
+}
+
+pub(crate) struct HostAdmission {
+    pub(crate) extension_init: ExtensionDataInit,
+}
+
+pub(crate) fn build(
+    config: &Config,
+    manifest_path: Option<&Path>,
+    arm: Option<Stage3gHostArm>,
+    observer_path: Option<&Path>,
+) -> anyhow::Result<HostAdmission> {
+    let mut extension_init = ExtensionDataInit::new();
+    let mut manifest_sha256 = None;
+    let mut observed_schema_sha256 = None;
+
+    if let Some(path) = manifest_path {
+        let arm = arm.context("Stage 3G arm missing for host manifest")?;
+        let bytes = std::fs::read(path)
+            .with_context(|| format!("read Stage 3G host manifest {}", path.display()))?;
+        let manifest: Stage3gHostManifest =
+            serde_json::from_slice(&bytes).context("parse strict Stage 3G host manifest")?;
+        validate_static_contract(&manifest)?;
+        anyhow::ensure!(
+            config.tool_registry.error_on_tool_collisions,
+            "Stage 3G requires fatal tool collisions"
+        );
+
+        let selected = match arm {
+            Stage3gHostArm::A => &manifest.arms.arm_a,
+            Stage3gHostArm::B => &manifest.arms.arm_b,
+        };
+        extension_init.insert(AllowedTools(
+            selected
+                .tool_ceiling
+                .iter()
+                .map(|name| match name.as_str() {
+                    ALLOWED_TOOL => Ok(ToolName::namespaced(
+                        CANONICAL_NAMESPACE,
+                        CANONICAL_FUNCTION,
+                    )),
+                    _ => anyhow::bail!("unreviewed Stage 3G tool ceiling"),
+                })
+                .collect::<anyhow::Result<Vec<_>>>()?,
+        ));
+
+        match (arm, selected.approved_delegate.as_ref()) {
+            (Stage3gHostArm::A, None) => {
+                anyhow::ensure!(
+                    config.mcp_servers.is_empty(),
+                    "Stage 3G Arm A must not configure MCP servers"
+                );
+                anyhow::ensure!(
+                    config.code_mode.direct_only_tool_namespaces.is_empty(),
+                    "Stage 3G Arm A must not configure direct-only namespaces"
+                );
+            }
+            (Stage3gHostArm::B, Some(delegate)) => {
+                let server = config
+                    .mcp_servers
+                    .get()
+                    .get(SERVER_KEY)
+                    .context("reviewed devhub_delegate MCP server missing from resolved config")?;
+                let resolved_hash = canonical_sha256(&serde_json::to_value(server)?)?;
+                anyhow::ensure!(
+                    resolved_hash == delegate.expected_mcp_server_config_sha256,
+                    "resolved devhub_delegate MCP config hash mismatch"
+                );
+                anyhow::ensure!(
+                    config.code_mode.direct_only_tool_namespaces == [CANONICAL_NAMESPACE],
+                    "approved delegate direct-only namespace mismatch"
+                );
+                anyhow::ensure!(
+                    config.mcp_servers.len() == 1,
+                    "approved delegate host must configure exactly one MCP server"
+                );
+                let schema_hash = canonical_sha256(&delegate.expected_input_schema)?;
+                anyhow::ensure!(
+                    schema_hash == SCHEMA_SHA256
+                        && schema_hash == delegate.expected_input_schema_sha256,
+                    "approved delegate schema hash mismatch"
+                );
+                extension_init.insert(ApprovedDelegatePolicy::delegate(
+                    server.clone(),
+                    delegate.expected_input_schema.clone(),
+                ));
+                observed_schema_sha256 = Some(schema_hash);
+            }
+            _ => anyhow::bail!("Stage 3G arm policy does not match selected arm"),
+        }
+        manifest_sha256 = Some(sha256_bytes(&bytes));
+    } else {
+        anyhow::ensure!(arm.is_none(), "Stage 3G arm requires host manifest");
+    }
+
+    if let Some(path) = observer_path {
+        extension_init.insert(ProofRouterObserver::new(
+            path.to_path_buf(),
+            manifest_sha256,
+            observed_schema_sha256,
+        ));
+    }
+
+    Ok(HostAdmission { extension_init })
+}
+
+fn validate_static_contract(manifest: &Stage3gHostManifest) -> anyhow::Result<()> {
+    anyhow::ensure!(
+        manifest.schema_version == MANIFEST_VERSION,
+        "unsupported Stage 3G host manifest version"
+    );
+    anyhow::ensure!(
+        manifest.expected_global_tool_mode == GLOBAL_MODE,
+        "Stage 3G global tool mode mismatch"
+    );
+    anyhow::ensure!(
+        manifest.error_on_tool_collisions,
+        "fatal collisions must be required"
+    );
+    anyhow::ensure!(
+        manifest.arms.arm_a.tool_ceiling.is_empty()
+            && manifest.arms.arm_a.approved_delegate.is_none(),
+        "Stage 3G Arm A must be an empty ceiling without delegate policy"
+    );
+    anyhow::ensure!(
+        manifest.arms.arm_b.tool_ceiling == [ALLOWED_TOOL],
+        "Stage 3G Arm B AllowedTools mismatch"
+    );
+    let delegate = manifest
+        .arms
+        .arm_b
+        .approved_delegate
+        .as_ref()
+        .context("Stage 3G Arm B delegate policy missing")?;
+    anyhow::ensure!(
+        delegate.server_key == SERVER_KEY,
+        "approved server key mismatch"
+    );
+    anyhow::ensure!(delegate.raw_tool == RAW_TOOL, "approved raw tool mismatch");
+    anyhow::ensure!(
+        delegate.canonical_namespace == CANONICAL_NAMESPACE,
+        "approved canonical namespace mismatch"
+    );
+    anyhow::ensure!(
+        delegate.canonical_function == CANONICAL_FUNCTION,
+        "approved canonical function mismatch"
+    );
+    anyhow::ensure!(
+        delegate.direct_only_tool_namespaces == [CANONICAL_NAMESPACE],
+        "approved direct-only namespace mismatch"
+    );
+    anyhow::ensure!(
+        is_sha256(&delegate.expected_mcp_server_config_sha256),
+        "invalid resolved MCP config hash"
+    );
+    anyhow::ensure!(
+        delegate.expected_input_schema_sha256 == SCHEMA_SHA256,
+        "unreviewed schema hash"
+    );
+    Ok(())
+}
+
+fn canonical_sha256(value: &Value) -> anyhow::Result<String> {
+    let canonical = canonicalize(value);
+    Ok(sha256_bytes(&serde_json::to_vec(&canonical)?))
+}
+
+fn canonicalize(value: &Value) -> Value {
+    match value {
+        Value::Object(map) => Value::Object(
+            map.iter()
+                .map(|(key, value)| (key.clone(), canonicalize(value)))
+                .collect::<BTreeMap<_, _>>()
+                .into_iter()
+                .collect(),
+        ),
+        Value::Array(items) => Value::Array(items.iter().map(canonicalize).collect()),
+        _ => value.clone(),
+    }
+}
+
+fn sha256_bytes(bytes: &[u8]) -> String {
+    format!("{:x}", Sha256::digest(bytes))
+}
+
+fn is_sha256(value: &str) -> bool {
+    value.len() == 64
+        && value
+            .bytes()
+            .all(|byte| byte.is_ascii_hexdigit() && !byte.is_ascii_uppercase())
+}
