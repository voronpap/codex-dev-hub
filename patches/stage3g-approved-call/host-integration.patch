+++ b/exec/src/approved_delegate_host.rs
@@ -0,0 +1,176 @@
+//! Trusted `codex exec` host admission for the single reviewed DevFabric delegate.
+//!
+//! This module accepts authority only from an explicit startup manifest. Task input,
+//! MCP metadata, model output, and project files never populate this state.
+
+use anyhow::Context;
+use codex_core::ApprovedDelegatePolicy;
+use codex_core::ProofRouterObserver;
+use codex_core::config::Config;
+use codex_extension_api::AllowedTools;
+use codex_extension_api::ExtensionDataInit;
+use codex_tools::ToolName;
+use serde::Deserialize;
+use serde_json::Value;
+use sha2::Digest;
+use sha2::Sha256;
+use std::collections::BTreeMap;
+use std::path::Path;
+
+const MANIFEST_VERSION: u32 = 1;
+const SERVER_KEY: &str = "devhub_delegate";
+const RAW_TOOL: &str = "devhub_delegate";
+const CANONICAL_NAMESPACE: &str = "mcp__devhub_delegate";
+const CANONICAL_FUNCTION: &str = "devhub_delegate";
+const ALLOWED_TOOL: &str = "mcp__devhub_delegate.devhub_delegate";
+const SCHEMA_SHA256: &str = "0f06b9fc3d912389721413789835053eefb2db7cc14781829bd57234c7e371be";
+const GLOBAL_MODE: &str = "CodeModeOnly";
+
+#[derive(Debug, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct ApprovedDelegateHostManifest {
+    schema_version: u32,
+    server_key: String,
+    raw_tool: String,
+    canonical_namespace: String,
+    canonical_function: String,
+    allowed_tools: Vec<String>,
+    expected_mcp_server_config_sha256: String,
+    expected_input_schema: Value,
+    expected_input_schema_sha256: String,
+    direct_only_tool_namespaces: Vec<String>,
+    expected_global_tool_mode: String,
+    error_on_tool_collisions: bool,
+}
+
+pub(crate) struct HostAdmission {
+    pub(crate) extension_init: ExtensionDataInit,
+}
+
+pub(crate) fn build(
+    config: &Config,
+    manifest_path: Option<&Path>,
+    observer_path: Option<&Path>,
+) -> anyhow::Result<HostAdmission> {
+    let mut extension_init = ExtensionDataInit::new();
+    let mut manifest_sha256 = None;
+    let mut observed_schema_sha256 = None;
+
+    if let Some(path) = manifest_path {
+        let bytes = std::fs::read(path)
+            .with_context(|| format!("read approved delegate host manifest {}", path.display()))?;
+        let manifest: ApprovedDelegateHostManifest = serde_json::from_slice(&bytes)
+            .context("parse strict approved delegate host manifest")?;
+        validate_static_contract(&manifest)?;
+
+        let server = config
+            .mcp_servers
+            .get(SERVER_KEY)
+            .context("reviewed devhub_delegate MCP server missing from resolved config")?;
+        let resolved_hash = canonical_sha256(&serde_json::to_value(server)?)?;
+        anyhow::ensure!(
+            resolved_hash == manifest.expected_mcp_server_config_sha256,
+            "resolved devhub_delegate MCP config hash mismatch"
+        );
+        anyhow::ensure!(
+            config.code_mode.direct_only_tool_namespaces == [CANONICAL_NAMESPACE],
+            "approved delegate direct-only namespace mismatch"
+        );
+        anyhow::ensure!(
+            config.tool_registry.error_on_tool_collisions,
+            "approved delegate requires fatal tool collisions"
+        );
+        anyhow::ensure!(
+            config.mcp_servers.len() == 1,
+            "approved delegate host must configure exactly one MCP server"
+        );
+
+        let schema_hash = canonical_sha256(&manifest.expected_input_schema)?;
+        anyhow::ensure!(
+            schema_hash == SCHEMA_SHA256
+                && schema_hash == manifest.expected_input_schema_sha256,
+            "approved delegate schema hash mismatch"
+        );
+
+        extension_init.insert(AllowedTools(vec![ToolName::namespaced(
+            CANONICAL_NAMESPACE,
+            CANONICAL_FUNCTION,
+        )]));
+        extension_init.insert(ApprovedDelegatePolicy::delegate(
+            server.clone(),
+            manifest.expected_input_schema,
+        ));
+        manifest_sha256 = Some(sha256_bytes(&bytes));
+        observed_schema_sha256 = Some(schema_hash);
+    }
+
+    if let Some(path) = observer_path {
+        extension_init.insert(ProofRouterObserver::new(
+            path.to_path_buf(),
+            manifest_sha256.clone(),
+            observed_schema_sha256,
+        ));
+    }
+
+    Ok(HostAdmission { extension_init })
+}
+
+fn validate_static_contract(manifest: &ApprovedDelegateHostManifest) -> anyhow::Result<()> {
+    anyhow::ensure!(manifest.schema_version == MANIFEST_VERSION, "unsupported host manifest version");
+    anyhow::ensure!(manifest.server_key == SERVER_KEY, "approved server key mismatch");
+    anyhow::ensure!(manifest.raw_tool == RAW_TOOL, "approved raw tool mismatch");
+    anyhow::ensure!(
+        manifest.canonical_namespace == CANONICAL_NAMESPACE,
+        "approved canonical namespace mismatch"
+    );
+    anyhow::ensure!(
+        manifest.canonical_function == CANONICAL_FUNCTION,
+        "approved canonical function mismatch"
+    );
+    anyhow::ensure!(manifest.allowed_tools == [ALLOWED_TOOL], "approved AllowedTools mismatch");
+    anyhow::ensure!(
+        manifest.direct_only_tool_namespaces == [CANONICAL_NAMESPACE],
+        "approved direct-only namespace mismatch"
+    );
+    anyhow::ensure!(
+        manifest.expected_global_tool_mode == GLOBAL_MODE,
+        "approved global tool mode mismatch"
+    );
+    anyhow::ensure!(manifest.error_on_tool_collisions, "fatal collisions must be required");
+    anyhow::ensure!(
+        is_sha256(&manifest.expected_mcp_server_config_sha256),
+        "invalid resolved MCP config hash"
+    );
+    anyhow::ensure!(
+        manifest.expected_input_schema_sha256 == SCHEMA_SHA256,
+        "unreviewed schema hash"
+    );
+    Ok(())
+}
+
+fn canonical_sha256(value: &Value) -> anyhow::Result<String> {
+    let canonical = canonicalize(value);
+    Ok(sha256_bytes(&serde_json::to_vec(&canonical)?))
+}
+
+fn canonicalize(value: &Value) -> Value {
+    match value {
+        Value::Object(map) => Value::Object(
+            map.iter()
+                .map(|(key, value)| (key.clone(), canonicalize(value)))
+                .collect::<BTreeMap<_, _>>()
+                .into_iter()
+                .collect(),
+        ),
+        Value::Array(items) => Value::Array(items.iter().map(canonicalize).collect()),
+        _ => value.clone(),
+    }
+}
+
+fn sha256_bytes(bytes: &[u8]) -> String {
+    format!("{:x}", Sha256::digest(bytes))
+}
+
+fn is_sha256(value: &str) -> bool {
+    value.len() == 64 && value.bytes().all(|byte| byte.is_ascii_hexdigit() && !byte.is_ascii_uppercase())
+}
