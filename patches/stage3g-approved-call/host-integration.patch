--- /dev/null
+++ b/core/src/proof_router_observer.rs
@@ -0,0 +1,107 @@
+//! Read-only, host-installed pre-sampling proof observer.
+
+use crate::ApprovedDelegatePolicy;
+use crate::tools::router::ToolRouter;
+use codex_extension_api::AllowedTools;
+use codex_tools::ResponsesApiNamespaceTool;
+use codex_tools::ToolSpec;
+use serde_json::json;
+use std::path::PathBuf;
+
+#[derive(Clone, Debug)]
+pub struct ProofRouterObserver {
+    output: PathBuf,
+    manifest_sha256: Option<String>,
+    expected_schema_sha256: Option<String>,
+}
+
+impl ProofRouterObserver {
+    pub fn new(
+        output: PathBuf,
+        manifest_sha256: Option<String>,
+        expected_schema_sha256: Option<String>,
+    ) -> Self {
+        Self {
+            output,
+            manifest_sha256,
+            expected_schema_sha256,
+        }
+    }
+
+    pub(crate) fn observe(
+        &self,
+        router: &ToolRouter,
+        dynamic_tool_count: usize,
+        allowed_tools: Option<&AllowedTools>,
+        policy: Option<&ApprovedDelegatePolicy>,
+    ) -> anyhow::Result<()> {
+        let specs = router.model_visible_specs();
+        let mut visible = Vec::new();
+        let mut hosted = Vec::new();
+        for spec in specs.iter() {
+            match spec {
+                ToolSpec::Function(tool) => visible.push(format!("functions.{}", tool.name)),
+                ToolSpec::Freeform(tool) => visible.push(format!("functions.{}", tool.name)),
+                ToolSpec::Namespace(namespace) => {
+                    for tool in &namespace.tools {
+                        let name = match tool {
+                            ResponsesApiNamespaceTool::Function(tool) => tool.name.as_str(),
+                            ResponsesApiNamespaceTool::Custom(tool) => tool.name.as_str(),
+                        };
+                        visible.push(format!("{}.{}", namespace.name, name));
+                    }
+                }
+                ToolSpec::ToolSearch { .. } => visible.push("tool_search".to_string()),
+                ToolSpec::WebSearch { .. } => {
+                    visible.push("web_search".to_string());
+                    hosted.push("web_search".to_string());
+                }
+            }
+        }
+        visible.sort();
+        hosted.sort();
+        let mut nested = router
+            .code_mode_tool_names()
+            .iter()
+            .map(|(wire, tool)| format!("{wire}={tool}"))
+            .collect::<Vec<_>>();
+        nested.sort();
+        let mut allowed = allowed_tools
+            .map(|tools| tools.0.iter().map(ToString::to_string).collect::<Vec<_>>())
+            .unwrap_or_default();
+        allowed.sort();
+        let identity = policy.and_then(ApprovedDelegatePolicy::proof_identity);
+        let evidence = json!({
+            "schema_version": 1,
+            "observer": "read_only_pre_sampling_router_v1",
+            "effective_tool_mode": format!("{:?}", router.tool_mode()),
+            "visible_model_tools": visible,
+            "nested_code_mode_map": nested,
+            "hosted_tools": hosted,
+            "dynamic_tool_count": dynamic_tool_count,
+            "allowed_tools": allowed,
+            "approved_delegate_policy_present": policy.is_some(),
+            "approved_identity": identity.as_ref().map(|identity| json!({
+                "server_key": identity.server_key,
+                "raw_tool": identity.raw_tool,
+                "canonical_namespace": identity.canonical_namespace,
+                "canonical_function": identity.canonical_function,
+                "generation_identity": identity.generation_identity,
+                "schema_sha256": self.expected_schema_sha256,
+            })),
+            "host_manifest_sha256": self.manifest_sha256,
+            "model_requests": 0,
+            "provider_sends": 0,
+            "real_codex_task_executions": 0,
+        });
+        let parent = self
+            .output
+            .parent()
+            .ok_or_else(|| anyhow::anyhow!("proof observer output requires parent directory"))?;
+        std::fs::create_dir_all(parent)?;
+        let temporary = self.output.with_extension("tmp");
+        std::fs::write(&temporary, serde_json::to_vec_pretty(&evidence)?)?;
+        std::fs::rename(temporary, &self.output)?;
+        Ok(())
+    }
+}
