{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/voronpap/codex-dev-hub/benchmarks/approved-delegate-host-manifest-v1.schema.json",
  "title": "Approved Delegate Host Manifest V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "server_key",
    "raw_tool",
    "canonical_namespace",
    "canonical_function",
    "allowed_tools",
    "expected_mcp_server_config_sha256",
    "expected_input_schema",
    "expected_input_schema_sha256",
    "direct_only_tool_namespaces",
    "expected_global_tool_mode",
    "error_on_tool_collisions"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "server_key": {
      "const": "devhub_delegate"
    },
    "raw_tool": {
      "const": "devhub_delegate"
    },
    "canonical_namespace": {
      "const": "mcp__devhub_delegate"
    },
    "canonical_function": {
      "const": "devhub_delegate"
    },
    "allowed_tools": {
      "type": "array",
      "prefixItems": [
        {
          "const": "mcp__devhub_delegate.devhub_delegate"
        }
      ],
      "items": false,
      "minItems": 1,
      "maxItems": 1
    },
    "expected_mcp_server_config_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "expected_input_schema": {
      "type": "object"
    },
    "expected_input_schema_sha256": {
      "const": "0f06b9fc3d912389721413789835053eefb2db7cc14781829bd57234c7e371be"
    },
    "direct_only_tool_namespaces": {
      "type": "array",
      "prefixItems": [
        {
          "const": "mcp__devhub_delegate"
        }
      ],
      "items": false,
      "minItems": 1,
      "maxItems": 1
    },
    "expected_global_tool_mode": {
      "const": "CodeModeOnly"
    },
    "error_on_tool_collisions": {
      "const": true
    }
  }
}
