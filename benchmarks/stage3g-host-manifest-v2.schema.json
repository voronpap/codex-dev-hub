{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/voronpap/codex-dev-hub/benchmarks/stage3g-host-manifest-v2.schema.json",
  "title": "Stage 3G Host Manifest V2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "expected_global_tool_mode",
    "error_on_tool_collisions",
    "arms"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "expected_global_tool_mode": {
      "const": "CodeModeOnly"
    },
    "error_on_tool_collisions": {
      "const": true
    },
    "arms": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "arm_a",
        "arm_b"
      ],
      "properties": {
        "arm_a": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "tool_ceiling",
            "approved_delegate"
          ],
          "properties": {
            "tool_ceiling": {
              "type": "array",
              "maxItems": 0
            },
            "approved_delegate": {
              "type": "null"
            }
          }
        },
        "arm_b": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "tool_ceiling",
            "approved_delegate"
          ],
          "properties": {
            "tool_ceiling": {
              "type": "array",
              "prefixItems": [
                {
                  "const": "mcp__devhub_delegate.devhub_delegate"
                }
              ],
              "items": false,
              "minItems": 1,
              "maxItems": 1
            },
            "approved_delegate": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "server_key",
                "raw_tool",
                "canonical_namespace",
                "canonical_function",
                "expected_mcp_server_config_sha256",
                "expected_input_schema",
                "expected_input_schema_sha256",
                "direct_only_tool_namespaces"
              ],
              "properties": {
                "server_key": {
                  "const": "devhub_delegate"
                },
                "raw_tool": {
                  "const": "devhub_delegate"
                },
                "canonical_namespace": {
                  "const": "mcp__devhub_delegate"
                },
                "canonical_function": {
                  "const": "devhub_delegate"
                },
                "expected_mcp_server_config_sha256": {
                  "const": "ff866e1aea6710de0373474e6671dbd412173a11cf0284c321e20c5b47ce199b"
                },
                "expected_input_schema": {
                  "type": "object"
                },
                "expected_input_schema_sha256": {
                  "const": "0f06b9fc3d912389721413789835053eefb2db7cc14781829bd57234c7e371be"
                },
                "direct_only_tool_namespaces": {
                  "type": "array",
                  "prefixItems": [
                    {
                      "const": "mcp__devhub_delegate"
                    }
                  ],
                  "items": false,
                  "minItems": 1,
                  "maxItems": 1
                }
              }
            }
          }
        }
      }
    }
  }
}
